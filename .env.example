# Aqualert / Synapsis EcoStream - Variaveis de Ambiente (Template)
# Copie este arquivo para .env e preencha com as credenciais do ambiente.

# Oracle Cloud Autonomous Database / ORDS (Scraper CETESB & Backend)
ORACLE_BASE_URL=https://sua-instancia.adb.sa-saopaulo-1.oraclecloudapps.com/ords/admin
ORACLE_TABELA_ENDPOINT=monitoramento_agua
ORACLE_CLIENT_ID=seu_client_id_oauth2_aqui
ORACLE_CLIENT_SECRET=seu_client_secret_oauth2_aqui
ORDS_READ_URL=https://sua-instancia.adb.sa-saopaulo-1.oraclecloudapps.com/ords/admin/publico/agua/

# Google Earth Engine
GEE_PROJECT_ID=seu-projeto-gee

# Seguranca e CORS da API FastAPI (MVP Hackathon)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Token opcional para proteger disparo manual do scraper se exposto em rede (deixe vazio no MVP local)
ADMIN_API_TOKEN=

# Frontend Vite
VITE_API_URL=http://localhost:8000
